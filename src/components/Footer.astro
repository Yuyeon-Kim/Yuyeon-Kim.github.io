---
import { profile } from '@/data/portfolio';
import { profileKo } from '@/data/portfolio-ko';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {year} <span data-i18n data-en={profile.name} data-ko={profile.koreanName}>{profile.name}</span></p>
    <p
      data-i18n
      data-en="AI research grounded in measurable outcomes."
      data-ko="측정 가능한 성과를 만드는 AI 연구."
    >AI research grounded in measurable outcomes.</p>
    <p data-i18n data-en={profile.location} data-ko={profileKo.location}>{profile.location}</p>
  </div>
</footer>
