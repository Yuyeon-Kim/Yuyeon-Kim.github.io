---
interface Props {
  eyebrow: string;
  eyebrowKo: string;
  title: string;
  titleKo: string;
  intro: string;
  introKo: string;
}

const { eyebrow, eyebrowKo, title, titleKo, intro, introKo } = Astro.props;
---

<section class="page-hero shell">
  <p class="eyebrow" data-i18n data-en={eyebrow} data-ko={eyebrowKo}>{eyebrow}</p>
  <h1 data-i18n data-en={title} data-ko={titleKo}>{title}</h1>
  <p data-i18n data-en={intro} data-ko={introKo}>{intro}</p>
</section>

