---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, intro, href, linkLabel = 'View all' } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {intro && <p class="section-intro">{intro}</p>}
  </div>
  {href && <a class="text-link" href={href} data-preserve-view>{linkLabel} <span aria-hidden="true">↗</span></a>}
</div>
