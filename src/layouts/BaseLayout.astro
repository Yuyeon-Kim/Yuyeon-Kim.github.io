---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  titleKo?: string;
  description?: string;
  descriptionKo?: string;
  page?: string;
}

const {
  title = 'Yuyeon Kim · AI Researcher & ML Engineer',
  titleKo = '김유연 · AI 연구자 & ML 엔지니어',
  description = 'Portfolio of Yuyeon Kim: medical AI, data science, computer vision, robotics, and semiconductor process optimization.',
  descriptionKo = '김유연의 포트폴리오: 의료 AI, 데이터 사이언스, 컴퓨터 비전, 로보틱스, 반도체 공정 최적화.',
  page = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} data-en={description} data-ko={descriptionKo} />
    <meta name="theme-color" content="#0b1220" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title data-en={title} data-ko={titleKo}>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const savedLanguage = localStorage.getItem('portfolio-language');
        const language = savedLanguage === 'ko' ? 'ko' : 'en';
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language === 'ko' ? 'ko' : 'en';
      } catch {
        document.documentElement.dataset.language = 'en';
      }
    </script>
  </head>
  <body data-page={page}>
    <a
      class="skip-link"
      href="#main-content"
      data-i18n
      data-en="Skip to content"
      data-ko="본문으로 건너뛰기"
    >Skip to content</a>
    <Header currentPage={page} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      const validViews = ['all', 'research', 'data', 'semiconductor', 'robotics'];
      const validLanguages = ['en', 'ko'];

      function currentLanguage() {
        try {
          const saved = localStorage.getItem('portfolio-language');
          return validLanguages.includes(saved) ? saved : 'en';
        } catch {
          return 'en';
        }
      }

      function currentView() {
        const view = new URLSearchParams(window.location.search).get('view') || 'all';
        return validViews.includes(view) ? view : 'all';
      }

      function updateInternalLinks(view) {
        document.querySelectorAll('a[data-preserve-view]').forEach((link) => {
          const url = new URL(link.getAttribute('href'), window.location.origin);
          if (view === 'all') url.searchParams.delete('view');
          else url.searchParams.set('view', view);
          link.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
        });
      }

      function viewName(view, language) {
        const active = document.querySelector(`[data-view-option="${view}"]`);
        return active?.getAttribute(`data-view-name-${language}`) ||
          (language === 'ko' ? '전체 경험' : 'All experience');
      }

      function applyView(view, announce = false) {
        const language = document.documentElement.dataset.language || 'en';
        document.documentElement.dataset.view = view;
        document.querySelectorAll('[data-view-option]').forEach((button) => {
          const active = button.dataset.viewOption === view;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('is-active', active);
        });

        document.querySelectorAll('[data-views]').forEach((item) => {
          const options = (item.dataset.views || '').split(' ');
          const match = view === 'all' || options.includes(view);
          item.classList.toggle('view-match', match);
          item.classList.toggle('view-muted', !match);
          if (item.hasAttribute('data-filter-item')) item.hidden = !match;
        });

        const visibleFilterItems = [...document.querySelectorAll('[data-filter-item]')]
          .filter((item) => !item.hidden).length;
        document.querySelectorAll('[data-view-count]').forEach((count) => {
          count.textContent = String(visibleFilterItems);
        });

        document.querySelectorAll('[data-view-label]').forEach((label) => {
          label.textContent = viewName(view, language);
        });

        updateInternalLinks(view);
        if (announce) {
          const live = document.querySelector('[data-view-live]');
          if (live) {
            const name = viewName(view, language);
            if (language === 'ko') {
              const countText = visibleFilterItems > 0 ? ` 일치하는 항목 ${visibleFilterItems}개를 표시합니다.` : '';
              live.textContent = `포트폴리오 관점을 ${name}(으)로 변경했습니다.${countText}`;
            } else {
              const countText = visibleFilterItems > 0 ? ` ${visibleFilterItems} matching items shown.` : '';
              live.textContent = `Portfolio view changed to ${name}.${countText}`;
            }
          }
        }
      }

      function applyLanguage(language, announce = false) {
        const nextLanguage = validLanguages.includes(language) ? language : 'en';
        document.documentElement.dataset.language = nextLanguage;
        document.documentElement.lang = nextLanguage === 'ko' ? 'ko' : 'en';
        try {
          localStorage.setItem('portfolio-language', nextLanguage);
        } catch {}

        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const value = element.getAttribute(`data-${nextLanguage}`);
          if (value !== null) element.textContent = value;
        });
        document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
          const value = element.getAttribute(`data-aria-${nextLanguage}`);
          if (value !== null) element.setAttribute('aria-label', value);
        });
        document.querySelectorAll('[data-i18n-alt]').forEach((element) => {
          const value = element.getAttribute(`data-alt-${nextLanguage}`);
          if (value !== null) element.setAttribute('alt', value);
        });
        document.querySelectorAll('[data-language-option]').forEach((button) => {
          const active = button.dataset.languageOption === nextLanguage;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('is-active', active);
        });

        const title = document.querySelector('title');
        const localizedTitle = title?.getAttribute(`data-${nextLanguage}`);
        if (localizedTitle) document.title = localizedTitle;
        const description = document.querySelector('meta[name="description"]');
        const localizedDescription = description?.getAttribute(`data-${nextLanguage}`);
        if (localizedDescription) description.setAttribute('content', localizedDescription);

        applyView(currentView());
        if (announce) {
          const live = document.querySelector('[data-language-live]');
          if (live) {
            live.textContent = nextLanguage === 'ko'
              ? '사이트 언어를 한국어로 변경했습니다.'
              : 'Site language changed to English.';
          }
        }
      }

      document.querySelectorAll('[data-view-option]').forEach((button) => {
        button.addEventListener('click', () => {
          const view = button.dataset.viewOption;
          const url = new URL(window.location.href);
          if (view === 'all') url.searchParams.delete('view');
          else url.searchParams.set('view', view);
          history.replaceState({}, '', url);
          applyView(view, true);
        });
      });

      document.querySelectorAll('[data-language-option]').forEach((button) => {
        button.addEventListener('click', () => {
          applyLanguage(button.dataset.languageOption, true);
        });
      });

      const menuButton = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-mobile-menu]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('is-open', !open);
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        document.querySelectorAll('[data-count]').forEach((element) => {
          const target = Number(element.dataset.count);
          const decimals = String(target).includes('.') ? 2 : 0;
          const prefix = element.dataset.prefix || '';
          const suffix = element.dataset.suffix || '';
          const direction = element.dataset.direction || '';
          const start = performance.now();
          const duration = 800;
          const frame = (time) => {
            const progress = Math.min((time - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const value = target * eased;
            element.textContent = `${prefix}${value.toFixed(decimals)}${suffix}${direction ? ` ${direction}` : ''}`;
            if (progress < 1) requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);
        });
      }

      applyLanguage(currentLanguage());
      window.addEventListener('popstate', () => applyView(currentView()));
    </script>
  </body>
</html>

