---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ViewSwitcher from '@/components/ViewSwitcher.astro';
import MetricStrip from '@/components/MetricStrip.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CareerMap from '@/components/CareerMap.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { profile, projects, publications } from '@/data/portfolio';
import { profileKo, publicationsKo } from '@/data/portfolio-ko';

const featuredSlugs = [
  'sulcus-aware-hippocampal-surface',
  'psychosis-hippocampal-shape',
  'maternal-depression-brain-similarity',
  'scalp-image-analysis',
  'smart-farm-vision-automation',
  'railway-lidar-inspection-robot',
];
const featured = featuredSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
---

<BaseLayout page="home">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span aria-hidden="true"></span>
        <span
          data-i18n
          data-en="AI research · data · engineered systems"
          data-ko="정신의학 · 의료영상 · 머신러닝"
        >AI research · data · engineered systems</span>
      </p>
      <h1 data-i18n data-en={profile.name} data-ko={profile.koreanName}>{profile.name}</h1>
      <p class="hero-role" data-i18n data-en={profile.role} data-ko={profileKo.role}>{profile.role}</p>
      <p class="hero-tagline" data-i18n data-en={profile.tagline} data-ko={profileKo.tagline}>{profile.tagline}</p>
      <p class="hero-summary" data-i18n data-en={profile.summary} data-ko={profileKo.summary}>{profile.summary}</p>
      <div class="hero-actions">
        <a class="button button--primary" href="/projects/" data-preserve-view>
          <span data-i18n data-en="Explore projects" data-ko="프로젝트 보기">Explore projects</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button button--quiet" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>

    <aside
      class="hero-evidence"
      aria-label="Portfolio evidence"
      data-i18n-aria-label
      data-aria-en="Portfolio evidence"
      data-aria-ko="포트폴리오 주요 근거"
    >
      <div class="evidence-header">
        <span data-i18n data-en="Selected evidence" data-ko="주요 성과">Selected evidence</span>
        <span>2021—2026</span>
      </div>
      <div class="evidence-main">
        <span class="evidence-number">32</span>
        <div>
          <strong data-i18n data-en="% lower sulcus error" data-ko="% 낮아진 고랑 오차">% lower sulcus error</strong>
          <p
            data-i18n
            data-en="while preserving topology and correspondence"
            data-ko="위상과 피험자 간 대응점을 유지하면서"
          >while preserving topology and correspondence</p>
        </div>
      </div>
      <div class="evidence-rows">
        <div><strong>90%</strong><span data-i18n data-en="faster 3D meshing" data-ko="단축한 3D 메쉬 생성 시간">faster 3D meshing</span></div>
        <div><strong>99.85%</strong><span data-i18n data-en="smaller teacher-to-student model" data-ko="줄인 Teacher 대비 Student 모델 크기">smaller teacher-to-student model</span></div>
        <div><strong>4</strong><span data-i18n data-en="field and industry collaborations" data-ko="현장·산업 공동연구">field and industry collaborations</span></div>
      </div>
      <div class="evidence-footer">
        <span>MICCAI · KCC · ACK · CES</span>
        <span class="pulse-dot" aria-hidden="true"></span>
      </div>
    </aside>
  </section>

  <section class="switcher-band">
    <div class="shell"><ViewSwitcher /></div>
  </section>

  <section class="metrics-section shell section-space">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow" data-i18n data-en="Measured outcomes" data-ko="정량적 성과">Measured outcomes</p>
        <h2 data-i18n data-en="Start with the result." data-ko="결과부터 보여드립니다.">Start with the result.</h2>
      </div>
      <p
        class="section-note"
        data-i18n
        data-en="Each number links to the reasoning, implementation, and validation behind it."
        data-ko="각 수치에는 문제 정의, 구현, 검증 과정이 연결되어 있습니다."
      >Each number links to the reasoning, implementation, and validation behind it.</p>
    </div>
    <MetricStrip />
  </section>

  <section class="projects-section shell section-space">
    <SectionHeading
      eyebrow="Selected work"
      eyebrowKo="주요 연구 및 프로젝트"
      title="Problems made smaller, faster, or more measurable."
      titleKo="의료영상 연구를 중심으로 확장해 온 프로젝트."
      intro="The portfolio view changes what appears first; the underlying evidence stays the same."
      introKo="해마 표면 복원과 정신의학 영상 분석을 중심으로, 컴퓨터 비전·로보틱스·제조 AI 경험을 함께 정리했습니다."
      href="/projects/"
      linkLabel="All projects"
      linkLabelKo="전체 프로젝트"
    />
    <div class="project-grid home-project-grid">
      {featured.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="map-section section-space">
    <div class="shell">
      <CareerMap />
    </div>
  </section>

  <section class="experience-section shell section-space">
    <SectionHeading
      eyebrow="Experience"
      eyebrowKo="경력"
      title="Research depth, field constraints, and delivery."
      titleKo="의료 AI 연구에서 현장 시스템 구현까지."
      intro="A focused timeline here; the full career archive includes research, industry collaboration, teaching, and early operations work."
      introKo="핵심 연구 경력과 함께 산업 공동연구, 교육, 운영 및 초기 실무 경험까지 전체 타임라인에 담았습니다."
      href="/experience/"
      linkLabel="Full timeline"
      linkLabelKo="전체 경력"
    />
    <ExperienceTimeline />
  </section>

  <section class="research-rail section-space">
    <div class="shell research-rail-inner">
      <div class="research-rail-copy">
        <p class="eyebrow" data-i18n data-en="Research record" data-ko="연구 실적">Research record</p>
        <h2
          data-i18n
          data-en={`${publications.length} papers and active manuscripts across geometry, vision, and neuroimaging.`}
          data-ko={`${publications.length}편의 논문 및 진행 중인 원고: 의료영상, 정신의학, 컴퓨터 비전 연구.`}
        >{publications.length} papers and active manuscripts across geometry, vision, and neuroimaging.</h2>
        <p
          data-i18n
          data-en="First-author MICCAI work, co-first collaborative studies, and engineering research that connects algorithms to operating constraints."
          data-ko="MICCAI 제1저자 연구, 공동 제1저자 협업 연구, 알고리즘을 실제 운영 제약과 연결한 공학 연구를 수행했습니다."
        >First-author MICCAI work, co-first collaborative studies, and engineering research that connects algorithms to operating constraints.</p>
        <a class="button button--light" href="/research/" data-preserve-view>
          <span data-i18n data-en="View publications" data-ko="논문 보기">View publications</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ol class="research-rail-list">
        {publications.slice(0, 3).map((publication, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong
                data-i18n
                data-en={publication.title}
                data-ko={publicationsKo[index].title}
              >{publication.title}</strong>
              <p>
                <span data-i18n data-en={publication.venue} data-ko={publicationsKo[index].venue}>{publication.venue}</span>
                {' · '}
                <span data-i18n data-en={publication.role} data-ko={publicationsKo[index].role}>{publication.role}</span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
