---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, type Project } from '@/data/portfolio';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const displayDate = (date: string) => date.replaceAll('-', '.');
const currentIndex = projects.findIndex((candidate) => candidate.slug === project.slug);
const projectViews = new Set(project.views.filter((view) => view !== 'all'));
const projectTags = new Set(project.tags.map((tag) => tag.toLowerCase()));

// Rank by meaningful overlap, then rotate ties from the current project so the
// first projects in the data file do not dominate every recommendation.
const related = projects
  .map((candidate, index) => {
    const sharedViews = candidate.views.filter(
      (view) => view !== 'all' && projectViews.has(view),
    ).length;
    const sharedTags = candidate.tags.filter((tag) =>
      projectTags.has(tag.toLowerCase()),
    ).length;
    const distance = (index - currentIndex + projects.length) % projects.length;

    return {
      project: candidate,
      score: sharedViews * 4 + sharedTags * 2,
      distance,
    };
  })
  .filter((candidate) => candidate.project.slug !== project.slug)
  .sort((a, b) => b.score - a.score || a.distance - b.distance)
  .slice(0, 3)
  .map((candidate) => candidate.project);
---

<BaseLayout
  page="projects"
  title={`${project.title} · Yuyeon Kim`}
  description={project.summary}
>
  <article class="case-study">
    <header class="case-hero shell">
      <div class="case-title-block">
        <a class="back-link" href="/projects/" data-preserve-view>← All projects</a>
        <p class="eyebrow">{project.eyebrow}</p>
        <h1>{project.title}</h1>
        <p class="case-deck">{project.summary}</p>
        <div class="case-meta">
          <span><b>Start date</b><time datetime={project.startDate}>{displayDate(project.startDate)}</time></span>
          <span><b>End date</b><time datetime={project.endDate}>{displayDate(project.endDate)}</time></span>
          <span><b>Context</b>{project.organization}</span>
        </div>
      </div>
      <aside class="case-results" aria-label="Key results">
        <p class="eyebrow">Key results</p>
        {project.metrics.map((metric) => (
          <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
        ))}
      </aside>
    </header>

    {project.image && (
      <div class="case-image-wrap shell">
        <img src={project.image} alt={project.imageAlt || ''} />
      </div>
    )}

    <div class="case-body shell">
      <aside class="case-nav">
        <p class="eyebrow">Case outline</p>
        <a href="#problem">01 · Problem</a>
        <a href="#difficulty">02 · Why difficult</a>
        <a href="#approach">03 · First approach</a>
        <a href="#decision">04 · Decision</a>
        <a href="#implementation">05 · Implementation</a>
        <a href="#result">06 · Result</a>
        <a href="#learning">07 · Learning</a>
      </aside>

      <div class="case-sections">
        <section id="problem"><span>01</span><p class="eyebrow">Problem</p><h2>What had to change?</h2><p>{project.problem}</p></section>
        <section id="difficulty"><span>02</span><p class="eyebrow">Why it was difficult</p><h2>The constraint behind the metric.</h2><p>{project.difficulty}</p></section>
        <section id="approach"><span>03</span><p class="eyebrow">First approach</p><h2>Make the failure measurable.</h2><p>{project.firstApproach}</p></section>
        <section id="decision"><span>04</span><p class="eyebrow">Decision</p><h2>Choose the right unit of work.</h2><p>{project.decision}</p></section>
        <section id="implementation"><span>05</span><p class="eyebrow">Implementation</p><h2>Connect the method to the system.</h2><p>{project.implementation}</p></section>
        <section id="result" class="case-result-section">
          <span>06</span><p class="eyebrow">Result</p><h2>Measured outcome.</h2><p>{project.result}</p>
          <div class="case-metric-grid">
            {project.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
          </div>
        </section>
        <section id="learning"><span>07</span><p class="eyebrow">What I learned</p><h2>How this changed my next decision.</h2><p>{project.learned}</p></section>
      </div>
    </div>

    <section class="case-tools shell">
      <div>
        <p class="eyebrow">Tools & methods</p>
        <div class="large-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
      </div>
      {project.links && project.links.length > 0 && (
        <div class="case-links">
          <p class="eyebrow">External links</p>
          {project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
        </div>
      )}
    </section>

    <section class="related-projects shell section-space">
      <div class="section-heading compact-heading"><div><p class="eyebrow">Continue</p><h2>Related work</h2></div></div>
      <div class="project-grid">{related.map((item, index) => <ProjectCard project={item} index={index} />)}</div>
    </section>
  </article>
</BaseLayout>
