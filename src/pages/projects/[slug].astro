---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, type Project } from '@/data/portfolio';
import { projectKoBySlug } from '@/data/portfolio-ko';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectKo = projectKoBySlug(project.slug)!;
const displayDate = (date: string) => date.replaceAll('-', '.');
const currentIndex = projects.findIndex((candidate) => candidate.slug === project.slug);
const projectViews = new Set(project.views.filter((view) => view !== 'all'));
const projectTags = new Set(project.tags.map((tag) => tag.toLowerCase()));
const linkLabelsKo: Record<string, string> = {
  Paper: '논문',
  'Code preview': '코드 미리보기',
  'POSTECH research highlight': 'POSTECH 연구 하이라이트',
  Code: '코드',
  'Related code': '관련 코드',
};

// Rank by meaningful overlap, then rotate ties from the current project so the
// first projects in the data file do not dominate every recommendation.
const related = projects
  .map((candidate, index) => {
    const sharedViews = candidate.views.filter(
      (view) => view !== 'all' && projectViews.has(view),
    ).length;
    const sharedTags = candidate.tags.filter((tag) =>
      projectTags.has(tag.toLowerCase()),
    ).length;
    const distance = (index - currentIndex + projects.length) % projects.length;

    return {
      project: candidate,
      score: sharedViews * 4 + sharedTags * 2,
      distance,
    };
  })
  .filter((candidate) => candidate.project.slug !== project.slug)
  .sort((a, b) => b.score - a.score || a.distance - b.distance)
  .slice(0, 3)
  .map((candidate) => candidate.project);
---

<BaseLayout
  page="projects"
  title={`${project.title} · Yuyeon Kim`}
  titleKo={`${projectKo.title} · 김유연`}
  description={project.summary}
  descriptionKo={projectKo.summary}
>
  <article class="case-study">
    <header class="case-hero shell">
      <div class="case-title-block">
        <a class="back-link" href="/projects/" data-preserve-view>
          ← <span data-i18n data-en="All projects" data-ko="전체 프로젝트">All projects</span>
        </a>
        <p class="eyebrow" data-i18n data-en={project.eyebrow} data-ko={projectKo.eyebrow}>{project.eyebrow}</p>
        <h1 data-i18n data-en={project.title} data-ko={projectKo.title}>{project.title}</h1>
        <p class="case-deck" data-i18n data-en={project.summary} data-ko={projectKo.summary}>{project.summary}</p>
        <div class="case-contribution">
          <p class="eyebrow" data-i18n data-en="My Contribution" data-ko="담당 역할">My Contribution</p>
          <p data-i18n data-en={project.contribution} data-ko={projectKo.contribution}>{project.contribution}</p>
        </div>
        <div class="case-meta">
          <span>
            <b data-i18n data-en="Start date" data-ko="시작일">Start date</b>
            <time datetime={project.startDate}>{displayDate(project.startDate)}</time>
          </span>
          <span>
            <b data-i18n data-en="End date" data-ko="종료일">End date</b>
            <time datetime={project.endDate}>{displayDate(project.endDate)}</time>
          </span>
          <span>
            <b data-i18n data-en="Context" data-ko="소속 · 배경">Context</b>
            <span data-i18n data-en={project.organization} data-ko={projectKo.organization}>{project.organization}</span>
          </span>
        </div>
      </div>
      <aside
        class="case-results"
        aria-label="Key results"
        data-i18n-aria-label
        data-aria-en="Key results"
        data-aria-ko="주요 성과"
      >
        <p class="eyebrow" data-i18n data-en="Key results" data-ko="주요 성과">Key results</p>
        {project.metrics.map((metric, index) => (
          <div>
            <strong data-i18n data-en={metric.value} data-ko={projectKo.metrics[index].value}>{metric.value}</strong>
            <span data-i18n data-en={metric.label} data-ko={projectKo.metrics[index].label}>{metric.label}</span>
          </div>
        ))}
      </aside>
    </header>

    {project.image && (
      <div class="case-image-wrap shell">
        <img
          src={project.image}
          alt={project.imageAlt || ''}
          data-i18n-alt
          data-alt-en={project.imageAlt || ''}
          data-alt-ko={projectKo.imageAlt}
        />
      </div>
    )}

    <div class="case-body shell" data-language-content={projectKo.sections ? 'en' : undefined}>
      <aside class="case-nav">
        <p class="eyebrow" data-i18n data-en="Case outline" data-ko="프로젝트 구성">Case outline</p>
        <a href="#problem">01 · <span data-i18n data-en="Problem" data-ko="연구 배경">Problem</span></a>
        <a href="#difficulty">02 · <span data-i18n data-en="Why difficult" data-ko="핵심 과제">Why difficult</span></a>
        <a href="#approach">03 · <span data-i18n data-en="First approach" data-ko="검토 과정">First approach</span></a>
        <a href="#decision">04 · <span data-i18n data-en="Decision" data-ko="연구 설계">Decision</span></a>
        <a href="#implementation">05 · <span data-i18n data-en="Implementation" data-ko="구현 및 분석">Implementation</span></a>
        <a href="#result">06 · <span data-i18n data-en="Result" data-ko="주요 결과">Result</span></a>
        <a href="#learning">07 · <span data-i18n data-en="Learning" data-ko="연구적 의미">Learning</span></a>
      </aside>

      <div class="case-sections">
        <section id="problem">
          <span>01</span>
          <p class="eyebrow" data-i18n data-en="Problem" data-ko="연구 배경">Problem</p>
          <h2 data-i18n data-en="What had to change?" data-ko="연구 배경">What had to change?</h2>
          <p data-i18n data-en={project.problem} data-ko={projectKo.problem}>{project.problem}</p>
        </section>
        <section id="difficulty">
          <span>02</span>
          <p class="eyebrow" data-i18n data-en="Why it was difficult" data-ko="핵심 과제">Why it was difficult</p>
          <h2 data-i18n data-en="The constraint behind the metric." data-ko="해결해야 했던 과제">The constraint behind the metric.</h2>
          <p data-i18n data-en={project.difficulty} data-ko={projectKo.difficulty}>{project.difficulty}</p>
        </section>
        <section id="approach">
          <span>03</span>
          <p class="eyebrow" data-i18n data-en="First approach" data-ko="검토 과정">First approach</p>
          <h2 data-i18n data-en="Make the failure measurable." data-ko="접근 방법 검토">Make the failure measurable.</h2>
          <p data-i18n data-en={project.firstApproach} data-ko={projectKo.firstApproach}>{project.firstApproach}</p>
        </section>
        <section id="decision">
          <span>04</span>
          <p class="eyebrow" data-i18n data-en="Decision" data-ko="연구 설계">Decision</p>
          <h2 data-i18n data-en="Choose the right unit of work." data-ko="최종 연구 설계">Choose the right unit of work.</h2>
          <p data-i18n data-en={project.decision} data-ko={projectKo.decision}>{project.decision}</p>
        </section>
        <section id="implementation">
          <span>05</span>
          <p class="eyebrow" data-i18n data-en="Implementation" data-ko="구현 및 분석">Implementation</p>
          <h2 data-i18n data-en="Connect the method to the system." data-ko="구현 및 분석">Connect the method to the system.</h2>
          <p data-i18n data-en={project.implementation} data-ko={projectKo.implementation}>{project.implementation}</p>
        </section>
        <section id="result" class="case-result-section">
          <span>06</span>
          <p class="eyebrow" data-i18n data-en="Result" data-ko="주요 결과">Result</p>
          <h2 data-i18n data-en="Measured outcome." data-ko="주요 결과">Measured outcome.</h2>
          <p data-i18n data-en={project.result} data-ko={projectKo.result}>{project.result}</p>
          <div class="case-metric-grid">
            {project.metrics.map((metric, index) => (
              <div>
                <strong data-i18n data-en={metric.value} data-ko={projectKo.metrics[index].value}>{metric.value}</strong>
                <span data-i18n data-en={metric.label} data-ko={projectKo.metrics[index].label}>{metric.label}</span>
              </div>
            ))}
          </div>
        </section>
        <section id="learning">
          <span>07</span>
          <p class="eyebrow" data-i18n data-en="What I learned" data-ko="연구적 의미">What I learned</p>
          <h2 data-i18n data-en="How this changed my next decision." data-ko="연구적 의미">How this changed my next decision.</h2>
          <p data-i18n data-en={project.learned} data-ko={projectKo.learned}>{project.learned}</p>
        </section>
      </div>
    </div>

    {projectKo.sections && (
      <div class="case-body shell" data-language-content="ko" lang="ko">
        <aside class="case-nav">
          <p class="eyebrow">프로젝트 구성</p>
          {projectKo.sections.map((section, index) => (
            <a href={'#ko-' + section.id}>
              {String(index + 1).padStart(2, '0')} · {section.title}
            </a>
          ))}
        </aside>
        <div class="case-sections case-editorial">
          {projectKo.sections.map((section, index) => (
            <section
              id={'ko-' + section.id}
              class:list={{ 'case-result-section': section.id === 'results' }}
            >
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h2>{section.title}</h2>
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              )}
              {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              {section.subsections?.map((subsection) => (
                <div class="case-subsection">
                  <h3>{subsection.title}</h3>
                  <p>{subsection.content}</p>
                </div>
              ))}
            </section>
          ))}
        </div>
      </div>
    )}

    <section class="case-tools shell">
      <div>
        <p class="eyebrow" data-i18n data-en="Tools & methods" data-ko={projectKo.sections ? '사용 기술' : '기술 및 방법'}>Tools & methods</p>
        <div class="large-tags">
          {project.tags.map((tag, index) => (
            <span data-i18n data-en={tag} data-ko={projectKo.tags[index]}>{tag}</span>
          ))}
        </div>
      </div>
      {project.links && project.links.length > 0 && (
        <div class="case-links">
          <p class="eyebrow" data-i18n data-en="External links" data-ko="외부 링크">External links</p>
          {project.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              <span
                data-i18n
                data-en={link.label}
                data-ko={projectKo.sections && link.label === 'Paper' ? '논문 보기' : linkLabelsKo[link.label] || link.label}
              >{link.label}</span> ↗
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="related-projects shell section-space">
      <div class="section-heading compact-heading">
        <div>
          <p class="eyebrow" data-i18n data-en="Continue" data-ko="이어보기">Continue</p>
          <h2 data-i18n data-en="Related work" data-ko="관련 프로젝트">Related work</h2>
        </div>
      </div>
      <div class="project-grid">
        {related.map((item, index) => <ProjectCard project={item} index={index} />)}
      </div>
    </section>
  </article>
</BaseLayout>
